@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(BasicRHI CONFIG REQUIRED)
find_dependency(BasicTelemetry CONFIG REQUIRED)
find_dependency(spdlog CONFIG REQUIRED)
find_dependency(flecs CONFIG REQUIRED)
find_dependency(Boost REQUIRED COMPONENTS container_hash)
if(@OPENRENDERGRAPH_ENABLE_DEBUG_UI@)
    find_dependency(imgui CONFIG REQUIRED)
    find_dependency(implot CONFIG REQUIRED)
    find_dependency(slang CONFIG REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/OpenRenderGraphTargets.cmake")

set_and_check(OpenRenderGraph_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
